# replace NA in all FDR columns with 1
fdr_cols <- grep("FDR", colnames(combined_wide), value = TRUE)
combined_wide[fdr_cols] <- lapply(
combined_wide[fdr_cols],
function(x) {
x[is.na(x)] <- 1
x
}
)
