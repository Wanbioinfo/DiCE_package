library(dplyr)
library(tidyr)
library(purrr)
# add source name
ob$Dataset     <- "Ob"
ocy$Dataset    <- "Ocy"
pre_ob$Dataset <- "Pre_Ob"
# combine all
combined_long <- bind_rows(ob, ocy, pre_ob)
# make one row per term
combined_wide <- combined_long %>%
select(
Dataset,
Category,
Term,
Up_FDR,
Down_FDR,
Up_Fold_Enrichment,
Down_Fold_Enrichment,
Up_Genes,
Down_Genes
) %>%
pivot_wider(
names_from = Dataset,
values_from = c(
Up_FDR,
Down_FDR,
Up_Fold_Enrichment,
Down_Fold_Enrichment,
Up_Genes,
Down_Genes
),
names_glue = "{Dataset}_{.value}"
) %>%
arrange(Category, Term)
View(ocy)
combined_long <- combined_long %>%
rename(
Up_Fold_Enrichment = `Up_Fold Enrichment`,
Down_Fold_Enrichment = `Down_Fold Enrichment`
)
combined_wide <- combined_long %>%
select(
Dataset,
Category,
Term,
Up_FDR,
Down_FDR,
`Up_Fold Enrichment`,
`Down_Fold Enrichment`,
Up_Genes,
